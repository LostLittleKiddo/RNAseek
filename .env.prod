# RNAseek Environment Configuration
# Copy to .env and fill in values.
# In production, set these as system environment variables instead.

# Environment: "development" or "production"
RNASEEK_ENV=production

# Django
DJANGO_SECRET_KEY=<generate-a-strong-secret-key>
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# PostgreSQL (required when RNASEEK_ENV=production)
DB_NAME=rnaseek
DB_USER=rnaseek
DB_PASSWORD=<strong-password>
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Media root (user uploads & pipeline outputs)
MEDIA_ROOT=/data/rnaseek/media

# ============================================================
# RNAseek — tusd Upload Daemon (v2)
# ============================================================
# Handles resumable file uploads via the tus protocol.
# Listens on port 1080, behind Nginx reverse proxy at /files/.
#
# On post-finish, POSTs to Django /api/tusd-hooks/ with:
#   - Cookie + X-Session-ID headers forwarded (session resolution)
#   - Event type sent as "Type": "post-finish" in the JSON body (tusd v2)
#
# The Concatenation extension is enabled by default in tusd v2
# with the file store, allowing tus-js-client parallelUploads
# to split a 50 GB file into N parts uploaded simultaneously.
# ============================================================

[Unit]
Description=RNAseek tusd Upload Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/rnaseek
EnvironmentFile=/home/ubuntu/apps/rnaseek/.env

ExecStart=/usr/local/bin/tusd \
    -host 127.0.0.1 \
    -port 1080 \
    -upload-dir /home/ubuntu/apps/rnaseek/media/uploads \
    -behind-proxy \
    -hooks-http http://127.0.0.1:8000/api/tusd-hooks/ \
    -hooks-http-forward-headers Cookie,X-Session-ID \
    -hooks-enabled-events post-finish \
    -disable-download \
    -max-size 0

# Allow many concurrent upload connections (parallel chunks × users)
LimitNOFILE=65536

Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

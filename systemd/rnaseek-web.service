# ============================================================
# RNAseek — Daphne ASGI Web Server
# ============================================================
# Handles HTTP + WebSocket on port 8000, behind Nginx reverse proxy.
# ============================================================

[Unit]
Description=RNAseek Daphne ASGI Server
After=network.target postgresql.service redis.service
Requires=postgresql.service redis.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/rnaseek
EnvironmentFile=/home/ubuntu/apps/rnaseek/.env
Environment=PATH=/opt/miniconda3/envs/rnaseek/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CONDA_PREFIX=/opt/miniconda3/envs/rnaseek

ExecStart=/opt/miniconda3/envs/rnaseek/bin/daphne -b 127.0.0.1 -p 8000 config.asgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# ============================================================
# RNAseek environment configuration template
# Copy this file to .env and fill in values for your environment.
# .env is gitignored — it will NEVER be overwritten by git pulls.
# ============================================================

# ── Environment ──
# Set to "production" on the prod server. Leave unset or "development" locally.
RNASEEK_ENV=development

# ── Django ──
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Database ──
# Production only (PostgreSQL). Dev uses SQLite by default — leave these unset.
# DB_NAME=rnaseek
# DB_USER=rnaseek
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ── Redis / Celery ──
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── Media (pipeline outputs) ──
# Override if media lives outside the repo (e.g. mounted NFS volume in prod).
# MEDIA_ROOT=/mnt/data/rnaseek/media

# ── Dev-only: run Celery tasks synchronously (no worker needed) ──
# Set to "1" to debug task logic without a running worker.
CELERY_EAGER=0

# ============================================================
# RNAseek .gitignore
# ============================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# ── Environment & Secrets ──
.env
.env.local
!.env.prod
*.pem
*.key

# ── Django ──
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ── Reference Genomes (44 GB+ of pre-built indexes & sequences) ──
pipeline/reference_genomes/

# ── Dev Test Dataset (FASTQ files, ~28 MB) ──
rnaseek_dev_dataset/*.fastq.gz
rnaseek_dev_dataset/*.fq.gz

# ── Bioinformatics File Types (large binary/text outputs) ──
*.ht2
*.fa
*.fasta
*.fna
*.gtf
*.gff
*.gff3
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sam
*.bam
*.bam.bai
*.cram
*.crai
*.vcf
*.vcf.gz
*.bcf
*.bed
*.bedGraph
*.bigwig
*.bw
*.h5
*.h5ad
*.hdf5
*.RData
*.rds
*.Rhistory

# ── IDE / Editors ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS Generated ──
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──
*.log
celerybeat-schedule
celerybeat.pid

# ── Node (if any frontend tooling is added later) ──
node_modules/

# ── Misc ──
*.app
*.exe
*.war
*.jar
TEST*.xml
*.flv
*.mov
*.wmv

doc/*
media/*
test/*
pipeline/reference_genomes/*
rnaseek_dev_dataset/*